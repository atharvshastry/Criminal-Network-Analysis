# Graph RAG / AI Investigation Assistant configuration.
# Copy this file to backend/.env and fill in GRAPH_RAG_LLM_API_KEY before
# running `uvicorn app.main:app --reload`. Never commit backend/.env --
# it's already gitignored.

# Turn the assistant off entirely (graph search/evidence/alerts endpoints
# are unaffected either way).
GRAPH_RAG_ENABLED=true

# Defaults to Google Gemini via its OpenAI-compatible chat-completions
# endpoint (https://ai.google.dev/gemini-api/docs/openai). Get a key at
# https://aistudio.google.com/apikey.
GRAPH_RAG_LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GRAPH_RAG_LLM_MODEL=gemini-3.6-flash
GRAPH_RAG_LLM_API_KEY=

# --- Fallback provider (recommended for demo day) --------------------------
# If the primary provider above is unreachable, overloaded (429/503), or
# times out -- even after the retries below -- the app automatically tries
# this SECOND, INDEPENDENT provider once before giving up. Deliberately a
# different vendor rather than just a different Gemini model: an outage on
# Gemini's own infrastructure would take out a same-vendor fallback too.
# Groq is a good pick -- free, and fast enough it barely adds latency even
# on the rare occasions it's actually needed. Get a free key at
# https://console.groq.com/keys. Leave GRAPH_RAG_LLM_FALLBACK_URL blank to
# disable fallback entirely.
#
# Model name note: Groq periodically retires models (e.g. llama-3.1-8b-instant
# was decommissioned 2026-08-16) and a stale name here fails with an opaque
# 404 "model_not_found" -- if that happens, check
# https://console.groq.com/docs/models for the current list. gpt-oss-20b
# below is Groq's own recommended replacement as of this writing.
GRAPH_RAG_LLM_FALLBACK_URL=https://api.groq.com/openai/v1/chat/completions
GRAPH_RAG_LLM_FALLBACK_MODEL=openai/gpt-oss-20b
GRAPH_RAG_LLM_FALLBACK_API_KEY=

# To point the PRIMARY provider at something other than Gemini instead
# (OpenAI, Groq, OpenRouter, a self-hosted llama.cpp/vLLM server, ...), just
# repoint GRAPH_RAG_LLM_URL/MODEL/API_KEY -- nothing else needs to change.
# Examples:
#   OpenAI:      GRAPH_RAG_LLM_URL=https://api.openai.com/v1/chat/completions
#                GRAPH_RAG_LLM_MODEL=gpt-4o-mini
#   Groq:        GRAPH_RAG_LLM_URL=https://api.groq.com/openai/v1/chat/completions
#                GRAPH_RAG_LLM_MODEL=openai/gpt-oss-20b
#   OpenRouter:  GRAPH_RAG_LLM_URL=https://openrouter.ai/api/v1/chat/completions
#                GRAPH_RAG_LLM_MODEL=meta-llama/llama-3.1-8b-instruct

GRAPH_RAG_TIMEOUT_SECONDS=30
GRAPH_RAG_MAX_EVIDENCE_CHARS=1500
GRAPH_RAG_MAX_EVIDENCE_RECORDS=8
GRAPH_RAG_MAX_NOTES=10

# --- Case-wide fallback (what makes the assistant answer *any* question) ---
# When main.py's rule-based intent classifier can't resolve a specific
# entity/intent for a question (an open-ended, comparative, or otherwise
# unrecognized question), the assistant falls back to a bounded snapshot of
# the whole case -- top entities, relationships, evidence, alerts, timeline
# -- instead of refusing to answer. These caps bound how much of that
# snapshot goes into the prompt (independent of the targeted-retrieval caps
# above); raise them for a small case where you want more coverage, lower
# them if a large uploaded case is pushing you toward your provider's
# context-length or token-rate limits.
GRAPH_RAG_MAX_FULL_ENTITIES=60
GRAPH_RAG_MAX_FULL_RELATIONSHIPS=100
GRAPH_RAG_MAX_FULL_EVIDENCE=15
GRAPH_RAG_MAX_FULL_TIMELINE=15
GRAPH_RAG_MAX_FULL_ALERTS=15
GRAPH_RAG_MAX_FULL_NOTES=20

# On a 429 (rate limited) or 503 (overloaded) from the PRIMARY provider,
# retry this many times with a short backoff before falling back -- this is
# what smooths over Gemini's free tier briefly 503ing under load. A read
# timeout or connection error retries once regardless of this setting,
# since each attempt already waits the full GRAPH_RAG_TIMEOUT_SECONDS.
GRAPH_RAG_LLM_MAX_RETRIES=2
GRAPH_RAG_LLM_RETRY_DELAY_SECONDS=2
